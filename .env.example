# Reference for the supported environment variables (the app reads the process environment; it does not parse .env).
# NEVER commit real secrets. All values below are placeholders.
APP_ENV=development            # development | test | production
DATABASE_URL=sqlite:///./cyber_risk.db
SECRET_KEY=<generate-with: python -c "import secrets;print(secrets.token_urlsafe(48))">
ACCESS_TOKEN_EXPIRE_MINUTES=30
HOST=127.0.0.1
PORT=8000
RATE_LIMIT_PER_MINUTE=240
LOGIN_LIMIT_PER_MINUTE=8
MAX_BODY_BYTES=1000000
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=2
JOB_BACKOFF_CAP_SECONDS=60
